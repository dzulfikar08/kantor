[Desktop Entry]
Type=Application
Name=Kantor Sheets
GenericName=Spreadsheet
Comment=Open and edit Excel spreadsheets
Exec=kantor --sheets %f
Icon=kantor-sheets
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;
StartupWMClass=kantor
Keywords=excel;xlsx;spreadsheet;calc;
