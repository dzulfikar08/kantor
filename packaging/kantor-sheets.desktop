[Desktop Entry]
Type=Application
Name=Kantor Sheets
GenericName=Spreadsheet
Comment=Open and edit Excel spreadsheets
Exec=kantor --sheets %F
Icon=kantor-sheets
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.ms-excel.sheet.binary.macroEnabled.12;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;text/csv;text/tab-separated-values;
StartupWMClass=kantor
Keywords=excel;xlsx;spreadsheet;calc;
