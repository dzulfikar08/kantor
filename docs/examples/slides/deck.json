{
  "size": "16:9",
  "units": "in",
  "preset": "consulting-navy",
  "theme": { "name": "Harbor" },
  "footer": { "text": "Lumen Logistics · Q3 operations review", "logo": "logo.png" },
  "transition": { "type": "fade", "duration": 0.6 },
  "slides": [
    {
      "kind": "cover",
      "background": { "picture": "sky.png" },
      "eyebrow": "Quarterly operations review · Q3",
      "title": "On time, for the third quarter running",
      "subtitle": "Lumen Logistics · made-up sample data",
      "notes": "Open with the headline: on-time delivery is up for the third quarter running."
    },
    {
      "eyebrow": "How it works",
      "title": "How a shipment moves",
      "subtitle": "Four steps from order to doorstep; pick & pack is where time goes",
      "elements": [
        {
          "type": "timeline", "style": "chevrons", "current": 2, "h": 2.6,
          "items": [
            { "title": "Order", "label": "Day 0", "text": "Booked online or by EDI" },
            { "title": "Pick & pack", "label": "Day 0–1", "text": "Slowest step: 0.9 days on average" },
            { "title": "Ship", "label": "Day 1–2", "text": "Line haul between hubs" },
            { "title": "Deliver", "label": "Day 2–3", "text": "Last mile, signed for" }
          ]
        },
        { "type": "callout", "tone": "info", "icon": "timer", "title": "Average door to door:", "text": "2.4 days against a target of 3." }
      ]
    },
    {
      "eyebrow": "Results",
      "title": "Three numbers that matter",
      "footer_note": "Figures are invented for this example",
      "elements": [
        {
          "type": "stat_cards",
          "items": [
            { "value": "96%", "label": "On-time delivery", "detail": "Up from 91% a year ago" },
            { "value": "−18%", "label": "Cost per parcel", "detail": "Route planning and fuller vans", "highlight": true },
            { "value": "4.7", "label": "Customer rating", "detail": "Out of 5, from 12,400 reviews" }
          ]
        }
      ]
    },
    {
      "eyebrow": "Partners",
      "title": "Carriers compared",
      "elements": [
        {
          "type": "table", "preset": "clean", "columns": [4, 2, 2, 2],
          "rows": [
            ["Carrier", "On time", "Cost / parcel", "Rating"],
            ["Northbound Freight", "97%", "$4.10", "4.8"],
            ["Bluewater Couriers", "94%", "$3.60", "4.5"],
            ["Ridgeway Express", { "text": "89%", "color": "danger", "bold": true }, "$3.20", "4.1"],
            [{ "text": "All carriers", "style": "card_title" }, "", "$3.70", "4.5"]
          ]
        }
      ]
    },
    {
      "eyebrow": "Growth",
      "title": "Volume is growing",
      "elements": [
        { "type": "picture", "path": "bars.png", "x": 0.75, "y": 2.2, "w": 4.2, "h": 4.2, "geometry": "roundRect", "radius": 0.2, "line": { "color": "divider", "width": "0.75pt" }, "alt": "Bar chart: parcels per month, rising" },
        { "type": "picture", "path": "sky.png", "x": 5.4, "y": 2.2, "w": 2.6, "h": 2.6, "fit": "cover", "geometry": "ellipse" },
        { "type": "picture", "path": "sky.png", "x": 8.4, "y": 2.2, "w": 2.2, "crop": { "left": 0.25, "right": 0.25 } },
        {
          "type": "numbered_list", "x": 5.4, "y": 5.1, "w": 7.2, "h": 1.3, "columns": 2, "boxed": false,
          "items": [
            { "title": "50,000 parcels", "text": "in September, a record" },
            { "title": "+22% on last year", "text": "mostly from two new retail clients" }
          ]
        }
      ],
      "notes": "Monthly volume passed 50,000 parcels in September."
    },
    {
      "eyebrow": "Next quarter",
      "title": "What happens next",
      "transition": { "type": "push", "direction": "left", "duration": 0.8 },
      "elements": [
        {
          "type": "cards", "h": 2.6,
          "items": [
            { "icon": "route", "title": "Pilot new routes", "text": "Three regional routes with fewer hub stops" },
            { "icon": "chart-line", "title": "Measure for 6 weeks", "text": "On-time rate, cost per parcel and rating, every week" },
            { "icon": "rocket", "title": "Roll out", "text": "Every region, if the pilot beats today's numbers" }
          ]
        },
        { "type": "callout", "tone": "warning", "title": "Decision point:", "text": "after week 6, go or stop on the numbers." }
      ],
      "notes": "Ask for approval of the six-week pilot."
    }
  ]
}
