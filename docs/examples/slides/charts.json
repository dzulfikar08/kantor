{
  "size": "16:9",
  "units": "in",
  "theme": {
    "name": "Harbor",
    "fonts": { "heading": "Carlito", "body": "Carlito" },
    "colors": {
      "dk2": "#1B2A4A",
      "lt2": "#EEF2F7",
      "accent1": "#2F5597",
      "accent2": "#F28C40",
      "accent3": "#4BA37B",
      "accent4": "#8064A2",
      "accent5": "#4BACC6",
      "accent6": "#C0504D"
    }
  },
  "text": { "font": "Carlito", "color": "#1B2A4A" },
  "slides": [
    {
      "layout": "Title Only",
      "title": "Revenue by quarter (made-up data)",
      "elements": [
        {
          "type": "chart", "chart": "column", "name": "Revenue",
          "x": 0.6, "y": 1.6, "w": 6, "h": 5.4,
          "title": "Revenue, IDR bn",
          "categories": ["Q1", "Q2", "Q3", "Q4"],
          "series": [
            { "name": "2025", "values": [41.2, 44.8, 39.5, 52.1], "color": "accent1" },
            { "name": "2026", "values": [45.0, 49.3, 47.7, null], "color": "accent2" }
          ],
          "number_format": "#,##0.0",
          "data_labels": { "show": "value", "position": "outside_end", "size": 10 },
          "axis": { "min": 0, "max": 60, "major_unit": 10, "title": "IDR bn" },
          "gap_width": 80, "legend": "bottom",
          "target_line": { "value": 45, "label": "Target 45", "color": "accent6" }
        },
        {
          "type": "chart", "chart": "bar", "name": "Sites below target",
          "x": 6.9, "y": 1.6, "w": 5.8, "h": 5.4,
          "title": "On-time delivery by site",
          "categories": ["Surabaya", "Jakarta", "Medan", "Makassar", "Semarang"],
          "series": [{ "name": "On time", "values": [0.97, 0.91, 0.84, 0.95, 0.88] }],
          "colors": [null, null, "#C00000", null, "#C00000"],
          "number_format": "0%",
          "data_labels": true,
          "axis": { "min": 0.5, "max": 1, "major_unit": 0.1, "gridlines": false },
          "font": { "size": 14 }
        }
      ]
    },
    {
      "layout": "Title Only",
      "title": "Trends",
      "elements": [
        {
          "type": "chart", "chart": "line", "name": "Shipments",
          "x": 0.6, "y": 1.6, "w": 6, "h": 5.4,
          "title": "Shipments per month",
          "categories": ["Jan", "Feb", "Mar", "Apr", "May", "Jun"],
          "series": [
            { "name": "Sea", "values": [120, 132, 128, 150, 161, 170] },
            { "name": "Air", "values": [40, 38, 52, 49, 58, 61], "line": { "width": "2.5pt", "dash": "sysDash" } }
          ],
          "category_axis": { "title": "2026" },
          "axis": { "title": "Shipments" }
        },
        {
          "type": "chart", "chart": "area", "stacked": true, "name": "Volume mix",
          "x": 6.9, "y": 1.6, "w": 5.8, "h": 5.4,
          "title": "Volume by product (stacked)",
          "categories": [2021, 2022, 2023, 2024, 2025, 2026],
          "series": [
            { "name": "Cold chain", "values": [10, 14, 18, 23, 27, 33] },
            { "name": "Bulk", "values": [30, 31, 29, 33, 35, 36] },
            { "name": "Parcel", "values": [12, 18, 25, 30, 34, 41] }
          ]
        }
      ]
    },
    {
      "layout": "Title Only",
      "title": "Mix",
      "elements": [
        {
          "type": "chart", "chart": "pie", "name": "Cost split",
          "x": 0.4, "y": 1.6, "w": 4.2, "h": 5.2,
          "title": "Cost split",
          "categories": ["Fuel", "Labour", "Maintenance", "Other"],
          "series": [{ "name": "Cost", "values": [42, 31, 17, 10] }],
          "data_labels": { "show": ["category", "percent"], "position": "best_fit" }
        },
        {
          "type": "chart", "chart": "doughnut", "name": "Fleet",
          "x": 4.6, "y": 1.6, "w": 4.2, "h": 5.2,
          "title": "Fleet by age",
          "categories": ["< 3 years", "3-6 years", "> 6 years"],
          "series": [{ "name": "Trucks", "values": [55, 30, 15] }],
          "colors": ["accent3", "accent5", "accent6"],
          "hole": 55, "data_labels": true
        },
        {
          "type": "chart", "chart": "column", "stacked": "percent", "name": "Channel share",
          "x": 8.8, "y": 1.6, "w": 4.2, "h": 5.2,
          "title": "Channel share",
          "categories": ["2024", "2025", "2026"],
          "series": [
            { "name": "Direct", "values": [60, 55, 48] },
            { "name": "Partner", "values": [30, 33, 37] },
            { "name": "Online", "values": [10, 12, 15] }
          ],
          "overlap": 100, "gap_width": 60
        }
      ]
    },
    {
      "layout": "Title Only",
      "title": "Relationships",
      "elements": [
        {
          "type": "chart", "chart": "scatter", "name": "Distance vs cost",
          "x": 0.6, "y": 1.6, "w": 6, "h": 5.4,
          "title": "Distance vs cost per trip",
          "categories": [120, 250, 310, 480, 650, 800, 940],
          "series": [{ "name": "Trips", "values": [1.9, 3.1, 3.6, 5.2, 6.8, 8.1, 9.0] }],
          "category_axis": { "title": "km", "min": 0, "max": 1000, "major_unit": 200 },
          "axis": { "title": "IDR m", "number_format": "0.0" }
        },
        {
          "type": "chart", "chart": "combo", "name": "Orders and margin",
          "x": 6.9, "y": 1.6, "w": 5.8, "h": 5.4,
          "title": "Orders and margin",
          "categories": ["Q1", "Q2", "Q3", "Q4"],
          "series": [
            { "name": "Orders", "values": [820, 910, 870, 1010], "type": "column" },
            { "name": "Margin", "values": [0.18, 0.21, 0.19, 0.24], "type": "line", "axis": "secondary", "color": "accent2" }
          ],
          "font": { "size": 14, "color": "tx1" }
        }
      ]
    }
  ]
}
